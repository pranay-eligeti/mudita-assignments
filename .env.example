# ---- app ----
BASE_URL=https://your-app.example.com          # public https URL; used for OAuth redirect + webhook URLs shown in the dashboard
SECRET_KEY=change-me-long-random               # signs the Google OAuth state
ADMIN_PASSWORD=change-me                       # HTTP Basic password (user: demo) for /a1; webhooks stay public but HMAC-verified
DATABASE_URL=                                  # postgres://... on Render free Postgres. Empty = SQLite at DB_PATH (tests/local)
DB_PATH=/data/app.db                           # SQLite file; put it on a persistent volume

# ---- LLM ----
LLM_PROVIDER=gemini                            # gemini (free tier, default) | anthropic
GEMINI_API_KEY=                                # Google AI Studio key, no card needed
ANTHROPIC_API_KEY=                             # only if LLM_PROVIDER=anthropic
MODEL=gemini-3.5-flash-lite                         # passed a live Intake check 2026-11-14; ids change often, re-check in AI Studio
MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash                             # e.g. a lighter free-tier model id; tried when MODEL stays overloaded (503/429)
PRICE_IN_PER_MTOK=0                            # ASSUMPTION for the cost display; verify against current Anthropic pricing
PRICE_OUT_PER_MTOK=0

# ---- Google (Gmail + Calendar) : one OAuth client, one dedicated TEST account ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_POLLING=1
GMAIL_POLL_SECONDS=30
EMAIL_ALLOWED_SENDERS=you@example.com,reviewer@example.com   # only these senders get automatic replies (empty = nobody)

# ---- WhatsApp Cloud API (Meta test number) ----
WA_VERIFY_TOKEN=choose-any-string
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0

# ---- Instagram API with Instagram Login ----
IG_VERIFY_TOKEN=choose-any-string
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
IG_GRAPH_VERSION=v25.0

# ---- Assignment 2 ----
A2_MAX_REVIEW_ROUNDS=3
A2_FAULT_INJECTION=1                           # enables the clearly-labelled simulated faults in the UI
